# RouteMind frontend configuration (optional). Copy to `.env.local`.
# The frontend holds NO third-party API keys: every external service is called by the backend.

# Where the Vite dev server forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:5000

# Set only when the frontend is hosted separately from the API (remember CORS_ORIGIN on the backend).
# VITE_API_BASE_URL=https://api.example.com/api

# Map tiles. Defaults to the OpenStreetMap tile server (fine for development; follow its usage policy).
# VITE_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
