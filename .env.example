# RouteMind backend configuration.
# Copy to `.env` (repository root) or `backend1/.env` and fill in what you need.
# Every variable is optional: without any of them RouteMind runs on free, key-less
# OpenStreetMap services (OSRM, Nominatim, Overpass) and Open-Meteo, with AI disabled.
# Never commit the real .env file.

# ---- Server ----
PORT=5000
MONGO_URI=mongodb+srv://routemind_user:vNzaioVF8JknkjaY@routemindcluster.drausc6.mongodb.net/?appName=RouteMindCluster
# Comma-separated browser origins allowed to call the API (only needed when the
# frontend is NOT served through the Vite dev proxy).
CORS_ORIGIN=http://localhost:5173,https://localhost:5173

# Public OSM services require an identifying User-Agent with contact details.
OSM_USER_AGENT=RouteMind/1.0 (emergency route planner prototype; contact: you@example.com)
NOMINATIM_EMAIL=

# ---- Routing ----
# osrm (default, no key, public demo server) | openrouteservice (needs ROUTING_API_KEY,
# supports avoid-areas so RouteMind can route around blocking hazards directly)
ROUTING_PROVIDER=osrm
ROUTING_API_KEY=
OSRM_BASE_URL=https://router.project-osrm.org
ORS_BASE_URL=https://api.openrouteservice.org
ROUTING_TIMEOUT_MS=12000

# ---- Geocoding (Nominatim-compatible; GEOCODING_API_KEY is sent as `key` for LocationIQ-style providers) ----
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_API_KEY=
GEOCODING_TIMEOUT_MS=8000

# ---- Emergency facility search (Overpass mirrors, tried in parallel with hedging; Nominatim is the fallback) ----
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.private.coffee/api/interpreter
OVERPASS_TIMEOUT_MS=25000

# ---- Weather (Open-Meteo, no key) ----
WEATHER_ENABLED=true
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_MS=6000

# ---- AI (Emergency Route Agent review via the Claude API). Leave empty to disable. ----
AI_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
AI_MAX_ITERATIONS=10
AI_TIMEOUT_MS=90000

# ---- Privacy / retention ----
HISTORY_RETENTION_DAYS=30
ROUTE_SESSION_RETENTION_DAYS=7
